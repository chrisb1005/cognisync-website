{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd cognisync-website && npm install && npm run build",
  "outputDirectory": "cognisync-website/dist",
  "rewrites": [
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
